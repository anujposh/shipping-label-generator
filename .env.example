# Shipping Label Generator environment
# slg-api now OWNS the /internal/shipping/* seam and the carrier clients.
# Configure SLG carrier credentials in api/.env (or the slg-api service env).
# The posh backend keeps separate credentials for its own carrier workflows.

# Database (same Postgres instance as backend, own slg_* tables + slg_knex_migrations)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/posh
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/posh_test_slg

# Internal shipping seam — now served by slg-api itself (local loopback).
# SLG_INTERNAL_API_ENABLED must be "true" for the seam to answer; otherwise
# every /internal/shipping/* path returns 404 like an unknown route.
SLG_INTERNAL_API_BASE_URL=http://127.0.0.1:3010
SLG_INTERNAL_API_KEY=change-me-in-production-min-32-characters-long
SLG_INTERNAL_API_ENABLED=true

# Optional: comma-separated client IP allowlist for /internal/shipping/*
# (IPv6-mapped entries are normalized). Unset/blank = allow any IP (secret
# still required).
#SLG_INTERNAL_API_ALLOWED_IPS=127.0.0.1,::ffff:127.0.0.1

# Optional: per-carrier service-catalog overrides ("code=Description,code")
#SLG_INTERNAL_SERVICES_FEDEX=
#SLG_INTERNAL_SERVICES_UPS=
#SLG_INTERNAL_SERVICES_USPS=
#SLG_INTERNAL_SERVICES_STAMPS=

# Non-production development without real carrier credentials: fake carriers
# return deterministic placeholder rates/labels. Never enable in production.
SLG_INTERNAL_FAKE_CARRIERS=false

# SLG carrier credentials — configure in the slg-api runtime env (api/.env in
# development). Values below are placeholders; never commit real secrets.
#CARRIER_SANDBOX=true
#FEDEX_API_KEY=
#FEDEX_API_SECRET=
#FEDEX_ACCOUNT_NUMBER=
# Optional FedEx Trade Documents Upload host override (normally auto-selected).
#FEDEX_DOCUMENT_BASE_URL=
#UPS_CLIENT_ID=
#UPS_CLIENT_SECRET=
#UPS_ACCOUNT_NUMBER=
#USPS_CLIENT_ID=
#USPS_CLIENT_SECRET=
#USPS_ACCOUNT_NUMBER=
#STAMPS_CLIENT_ID=
#STAMPS_CLIENT_SECRET=
#STAMPS_REFRESH_TOKEN=

# Admin session signing (must be >= 32 characters in production)
JWT_SECRET=change-me-in-production-min-32-characters-long

# Admin seed credentials (used by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!

# Optional: JSON array of approved ship-from addresses. If set, admin link
# creation will reject any shipFrom not matching an entry exactly.
# SLG_ALLOWED_SHIP_FROMS=[{"name":"Warehouse","street":"123 Main St","city":"Vancouver","state":"BC","zip":"V6B1A1","country":"CA"}]

# Service ports
API_PORT=3010
APP_PORT=3011

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# SMTP for shipment notification emails (sent to the vendor contact email and
# the notification email the vendor enters, when they opt in at label creation).
# Leave SMTP_HOST empty to disable sending (label creation is never affected).
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=no-reply@example.com

# Per-company SMTP identities for notification emails. When a link belongs
# to a Business Central company whose name matches (substring, first match
# wins: silk before posh), the label notification is sent from that
# company's mailbox with its credentials instead of the generic SMTP_* set.
# Host/port/secure remain shared. Missing user+password falls back to the
# generic identity.
#POSH_SMTP_USER=
#POSH_SMTP_PASSWORD=
#POSH_SMTP_FROM=
#SILK_SMTP_USER=
#SILK_SMTP_PASSWORD=
#SILK_SMTP_FROM=

# SMTP for shipment notification emails (sent to vendor + notification email
# when the vendor opts in). Leave SMTP_HOST empty to disable sending.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=no-reply@example.com

# Business Central companies directory (admin link-creation company dropdown)
#BC_TENANT_ID=
#BC_CLIENT_ID=
#BC_CLIENT_SECRET=
#BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0
#BC_ENVIRONMENT=Sandbox
