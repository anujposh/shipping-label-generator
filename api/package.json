{
  "name": "slg-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "mkdir -p ../logs && umask 077 && node dist/src/server.js >> ../logs/api.log 2>&1",
    "dev": "mkdir -p ../logs && umask 077 && tsx src/server.ts >> ../logs/api.log 2>&1",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:production": "knex migrate:latest --knexfile dist/knexfile.js --env production",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "sandbox:labels": "tsx scripts/sandbox-label-check.ts",
    "unit": "DATABASE_URL=\"${DATABASE_URL:-postgresql://unit:unit@127.0.0.1:1/unit}\" SLG_INTERNAL_API_BASE_URL=http://127.0.0.1:1 SLG_INTERNAL_API_KEY=test-key-32-characters-long!! JWT_SECRET=test-secret-32-characters-long!! node --import tsx --test tests/unit/*.test.ts",
    "integration": "DATABASE_URL=\"$TEST_DATABASE_URL\" node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=120000 tests/integration/*.test.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"migrations/**/*.ts\" \"tests/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"migrations/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^6.9.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "rate-limiter-flexible": "^5.0.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
